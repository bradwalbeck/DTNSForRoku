<?xml version="1.0" encoding="utf-8" ?>
<component name="LoadingIndicator" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/LoadingIndicator.brs" />
    <children>
        <Rectangle 
            width="200"
            height="100"
            color="0x000000AA"
            translation="[-100, -50]"
        />
        <Label 
            id="loadingLabel"
            text="Loading..."
            translation="[-100, -25]"
            width="200"
            height="50"
            font="font:LargeBoldSystemFont"
            color="0xFFFFFFFF"
            horizAlign="center"
            vertAlign="center"
        />
        <BusySpinner 
            id="spinner"
            translation="[-25, -40]"
            poster="pkg:/images/spinner.png"
        />
    </children>
</component>