<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <children>
        <Label 
            id="loadingLabel"
            text="Loading DTNS Videos..."
            translation="[640, 360]"
            width="640"
            height="100"
            font="font:LargeBoldSystemFont"
            color="0xFFFFFFFF"
            horizAlign="center"
            vertAlign="center"
            visible="true"
        />
        <RowList 
            id="videoList"
            numRows="1"
            itemSize="[400, 300]"
            translation="[100, 200]"
            visible="false"
        />
        <Video 
            id="videoPlayer"
            width="1920"
            height="1080"
            translation="[0, 0]"
            visible="false"
        />
    </children>
</component>