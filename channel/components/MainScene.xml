<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <interface>
    </interface>
    <children>
        <!-- Loading indicator -->
        <LoadingScreen id="loadingScreen" />

        <!-- Episode list, now wider and centered -->
        <RowList 
            id="episodeList"
            itemComponentName="EpisodeListItem"
            numRows="1"
            itemSize="[1280, 120]"
            rowItemSpacing="[0.0, 10.0]"
            translation="[320, 120]"
            visible="false"
        />

        <!-- Video player, initially invisible -->
        <Video
            id="videoPlayer"
            width="1920"
            height="1080"
            visible="false"
        />
    </children>
</component>